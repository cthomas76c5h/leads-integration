<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>LeadIntegrations.Api</AssemblyName>
    <RootNamespace>LeadIntegrations.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Receivers.fs" />
    <Compile Include="Handlers.fs" />
    <Compile Include="Portal.fs" />
    <Compile Include="TestControl.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.fsproj" />
  </ItemGroup>

</Project>
