{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Scenario",
  "description": "A story about lead delivery stated as data: given a starting state, when things happen on a timeline, then these states hold. Words are the glossary's (GLOSSARY.md). See README.md in this folder.",
  "type": "object",
  "required": [
    "name",
    "story",
    "slice",
    "model",
    "proves",
    "given",
    "when",
    "then"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "story": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12,
      "description": "RFC-007 section 8"
    },
    "model": {
      "enum": [
        "production",
        "lab",
        "proposed"
      ],
      "description": "Which rules the expectations state: what production does, what the lab does, or the agreed model not yet built"
    },
    "proves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "The rules it proves, as links into the model docs"
    },
    "today": {
      "type": "string",
      "description": "Where the lab or production differs from these expectations, if it does"
    },
    "given": {
      "type": "object",
      "required": [
        "clock",
        "firms",
        "destinations"
      ],
      "additionalProperties": false,
      "properties": {
        "clock": {
          "type": "string",
          "format": "date-time",
          "description": "Time zero; every 'at' is an offset from it"
        },
        "taxonomy": {
          "type": "string",
          "description": "Taxonomy version; the current one if absent"
        },
        "firms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "description": "Fictional, always"
              }
            }
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "firm",
              "kind",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "firm": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "type": "string",
                "description": "A destination kind; for CRMs, a file in receivers/"
              },
              "role": {
                "enum": [
                  "usual",
                  "fallback"
                ]
              },
              "state": {
                "$ref": "#/$defs/destinationState",
                "default": "live"
              },
              "routing": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Call categories it takes; every category if absent"
                  },
                  "chatLeads": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "mapping": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "The body fields its live revision sends (webhook kinds); the standard body if absent"
              },
              "duplicates": {
                "$ref": "#/$defs/duplicates",
                "description": "The duplicate handling this scenario assumes for the destination, where its kind's receiver contract has not confirmed one"
              }
            }
          }
        }
      }
    },
    "when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "then": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expectation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "offset": {
      "type": "string",
      "pattern": "^\\+(?=[0-9])([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
      "description": "Time after the clock's start, largest unit first: +30s, +5m, +2h30m, +1d, +25h10m"
    },
    "destinationState": {
      "enum": [
        "setting-up",
        "live",
        "paused",
        "needs-reconnection",
        "switched-off"
      ]
    },
    "deliveryState": {
      "enum": [
        "queued",
        "sending",
        "retrying",
        "accepted",
        "refused",
        "gave-up",
        "not-sent",
        "held",
        "cancelled",
        "unknown"
      ],
      "description": "The model's delivery states. 'unknown' (RFC-008 §4.2-4.3): the last attempt was sent but no answer came, and the kind cannot tell a duplicate, so the delivery waits for an operator to check and resend or close"
    },
    "failureClass": {
      "enum": [
        "transient",
        "lead",
        "configuration",
        "connection",
        "ours"
      ]
    },
    "handOffState": {
      "enum": [
        "pending",
        "reached",
        "reached-by-fallback",
        "expired"
      ]
    },
    "leadOutcome": {
      "enum": [
        "no-destination",
        "in-progress",
        "held",
        "needs-attention",
        "not-sent",
        "accepted",
        "expired"
      ]
    },
    "answer": {
      "description": "How a destination's receiver answers: a mode from receivers/modes.json, an exact answer, or no answer at all",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string"
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Fields this receiver requires on top of its kind's own"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "body": {
              "type": "string"
            },
            "retryAfter": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "noAnswer"
          ],
          "additionalProperties": false,
          "properties": {
            "noAnswer": {
              "const": true
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "at"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "at": {
          "$ref": "#/$defs/offset"
        },
        "lead": {
          "description": "A lead is recorded. Callers are invented; only what the rules read is stated",
          "type": "object",
          "required": [
            "id",
            "firm",
            "category"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "firm": {
              "$ref": "#/$defs/id"
            },
            "category": {
              "type": "string"
            },
            "practiceArea": {
              "type": "string"
            },
            "channel": {
              "enum": [
                "call",
                "chat"
              ],
              "default": "call"
            },
            "test": {
              "type": "boolean",
              "default": false
            },
            "only": {
              "$ref": "#/$defs/id",
              "description": "For a test lead: the one destination under test"
            },
            "hangUp": {
              "type": "boolean",
              "default": false,
              "description": "The caller left before giving a name"
            },
            "conversation": {
              "type": "string",
              "description": "The channel's own conversation id, the key that makes intake idempotent (RFC-008 §4.1)"
            }
          }
        },
        "receiver": {
          "description": "From this time on, the destination's receiver answers like this",
          "type": "object",
          "required": [
            "destination",
            "answers"
          ],
          "additionalProperties": false,
          "properties": {
            "destination": {
              "$ref": "#/$defs/id"
            },
            "answers": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        "action": {
          "description": "An operator, senior operator or firm contact does something. change-mapping prepares a draft revision; approve is the firm contact approving it, after which it is live (setup's test and confirm steps are not modelled). change-routing prepares a draft revision with a new routing rule. Revisions are numbered per destination: the given live one is 1, and each approval makes the next one live. acknowledge: the firm contact confirms a lead reached them. correct-classification: a reviewer or the firm contact corrects a lead's category",
          "type": "object",
          "required": [
            "by",
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "enum": [
                "operator",
                "senior-operator",
                "firm-contact",
                "reviewer"
              ]
            },
            "do": {
              "enum": [
                "resend",
                "pause",
                "resume",
                "reactivate",
                "reconnect",
                "send-missed",
                "change-mapping",
                "approve",
                "change-routing",
                "acknowledge",
                "correct-classification"
              ]
            },
            "destination": {
              "$ref": "#/$defs/id"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "why": {
              "type": "string"
            },
            "refused": {
              "type": "boolean",
              "default": false,
              "description": "The actor lacks the permission: the action must be refused and change nothing"
            },
            "mapping": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "change-mapping: the body fields the draft revision sends"
            },
            "routing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "change-routing: the routing rule the draft revision takes"
            },
            "applyToWaiting": {
              "type": "boolean",
              "default": false,
              "description": "approve: whether deliveries still waiting move to the new revision (RFC-008 §5.2)"
            },
            "via": {
              "enum": [
                "sms-reply",
                "link",
                "portal"
              ],
              "description": "acknowledge: how the firm confirmed receipt (RFC-008 §3.1)"
            },
            "category": {
              "type": "string",
              "description": "correct-classification: the corrected call category"
            }
          }
        },
        "fault": {
          "description": "Something goes wrong inside our own system (RFC-008 §10). Facts only: what happens, to which lead or delivery",
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "worker-crash-after-send",
                "second-worker-claims",
                "worker-stalls-before-send",
                "worker-continues",
                "lease-expires",
                "database-unavailable",
                "database-available",
                "intake-event-repeated",
                "answer-held",
                "answer-released"
              ],
              "description": "worker-crash-after-send: the destination received the request and the worker died before recording an answer. second-worker-claims: another worker tries to claim a delivery that is already claimed. worker-stalls-before-send: a worker claims a delivery and stops just before transmitting; worker-continues resumes it. lease-expires: the claim of a stalled worker runs out. database-unavailable / database-available: our database stops and starts answering. intake-event-repeated: the channel sends a lead's completion event again answer-held: the next request to the destination is sent and received, and its answer is held: the attempt is on the wire; answer-released: the held answer arrives."
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "destination": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "access": {
          "description": "A firm's user asks for a lead through a public boundary (RFC-008 §9); an access expectation says whether it is allowed",
          "type": "object",
          "required": [
            "firm",
            "lead",
            "boundary"
          ],
          "additionalProperties": false,
          "properties": {
            "firm": {
              "$ref": "#/$defs/id",
              "description": "The firm the requester belongs to"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "boundary": {
              "enum": [
                "read",
                "list",
                "export",
                "resend"
              ]
            }
          }
        },
        "cycleCloses": {
          "description": "The firm's billing cycle closes: its statement is locked as rated (RFC-003)",
          "type": "object",
          "required": [
            "firm"
          ],
          "additionalProperties": false,
          "properties": {
            "firm": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "expectation": {
      "description": "A state, an emitted event or a prohibited effect that holds at the given time. Exactly one of destination, delivery, noDelivery, handOff, outcome, capture, access, classification, billing, event, noEvent, noAttempt",
      "type": "object",
      "required": [
        "at"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "at": {
          "$ref": "#/$defs/offset"
        },
        "destination": {
          "type": "object",
          "required": [
            "id",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "$ref": "#/$defs/destinationState"
            },
            "failureStreak": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "delivery": {
          "description": "The newest delivery of this lead to this destination",
          "type": "object",
          "required": [
            "lead",
            "destination",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "destination": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "$ref": "#/$defs/deliveryState"
            },
            "failureClass": {
              "$ref": "#/$defs/failureClass"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "late": {
              "type": "boolean",
              "description": "Accepted after the lead's window to act"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "description": "How many deliveries this lead has to this destination, resends included"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "The revision this delivery uses (RFC-008 §5.2)"
            },
            "evidence": {
              "enum": [
                "submitted",
                "accepted",
                "verified"
              ],
              "description": "The strongest evidence for this delivery (RFC-008 §3.1)"
            },
            "verifyOverdue": {
              "type": "boolean",
              "description": "Accepted, but the destination's lookup has not found the record within the set time"
            },
            "outcomes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/attemptOutcome"
              },
              "description": "Each attempt's outcome, in order"
            },
            "reason": {
              "type": "string",
              "description": "Words the reason must contain, for a cancelled or not-sent delivery"
            }
          }
        },
        "handOff": {
          "type": "object",
          "required": [
            "lead",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "$ref": "#/$defs/handOffState"
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "The destination that reached the firm"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            },
            "escalated": {
              "type": "boolean",
              "description": "Escalated to an operator who calls the firm (RFC-008 §3.2)"
            }
          }
        },
        "outcome": {
          "type": "object",
          "required": [
            "lead",
            "is"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "is": {
              "$ref": "#/$defs/leadOutcome"
            }
          }
        },
        "noDelivery": {
          "description": "This lead has no delivery to this destination at all",
          "type": "object",
          "required": [
            "lead",
            "destination"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "destination": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "capture": {
          "description": "What intake recorded for a lead (RFC-008 §4.1)",
          "type": "object",
          "required": [
            "lead",
            "is"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "is": {
              "enum": [
                "recorded",
                "not-recorded"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "How many leads exist for the lead's conversation"
            },
            "channelTold": {
              "enum": [
                "recorded",
                "not-recorded"
              ],
              "description": "What intake answered the channel"
            }
          }
        },
        "access": {
          "description": "The answer to the access step with the same firm, lead and boundary",
          "type": "object",
          "required": [
            "firm",
            "lead",
            "boundary",
            "is"
          ],
          "additionalProperties": false,
          "properties": {
            "firm": {
              "$ref": "#/$defs/id"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "boundary": {
              "enum": [
                "read",
                "list",
                "export",
                "resend"
              ]
            },
            "is": {
              "enum": [
                "allowed",
                "refused"
              ]
            },
            "audited": {
              "type": "boolean"
            }
          }
        },
        "classification": {
          "description": "A lead's current classification and its kept history (RFC-008 §6.2)",
          "type": "object",
          "required": [
            "lead",
            "category"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "category": {
              "type": "string"
            },
            "records": {
              "type": "integer",
              "minimum": 1,
              "description": "Classification records kept for the lead, superseded ones included"
            },
            "offered": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "Destinations offered to an operator because the lead now matches them"
            }
          }
        },
        "billing": {
          "description": "How the lead's conversation is billed (RFC-008 §6.2)",
          "type": "object",
          "required": [
            "lead",
            "is"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "$ref": "#/$defs/id"
            },
            "is": {
              "enum": [
                "billable",
                "free",
                "under-review",
                "credited-next-cycle"
              ]
            }
          }
        },
        "event": {
          "description": "Exactly `count` events with this name about these ids have been emitted by then (1 if absent). Names are from events.json. Name the lead, destination or firm the event is about, at least one",
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "lead"
              ]
            },
            {
              "required": [
                "destination"
              ]
            },
            {
              "required": [
                "firm"
              ]
            }
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "destination": {
              "$ref": "#/$defs/id"
            },
            "firm": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "noEvent": {
          "description": "A prohibited effect: no event with this name about these ids is emitted between `after` and `before` (from the start, and up to the expectation's own time, if absent)",
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "lead"
              ]
            },
            {
              "required": [
                "destination"
              ]
            },
            {
              "required": [
                "firm"
              ]
            }
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "destination": {
              "$ref": "#/$defs/id"
            },
            "firm": {
              "$ref": "#/$defs/id"
            },
            "after": {
              "$ref": "#/$defs/offset"
            },
            "before": {
              "$ref": "#/$defs/offset"
            }
          }
        },
        "noAttempt": {
          "description": "A prohibited effect: no attempt is started to this destination (for this lead, if named) between `after` and `before` (from the start, and up to the expectation's own time, if absent)",
          "type": "object",
          "required": [
            "destination"
          ],
          "additionalProperties": false,
          "properties": {
            "destination": {
              "$ref": "#/$defs/id"
            },
            "lead": {
              "$ref": "#/$defs/id"
            },
            "after": {
              "$ref": "#/$defs/offset"
            },
            "before": {
              "$ref": "#/$defs/offset"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "enum": [
        "submitted",
        "accepted",
        "verified",
        "acknowledged"
      ],
      "description": "The strongest evidence reached (RFC-008 §3.1); 'acted on' is never part of the promise"
    },
    "attemptOutcome": {
      "enum": [
        "answered",
        "not-sent",
        "unknown",
        "ours"
      ],
      "description": "How an attempt ended (RFC-008 §4.2)"
    },
    "duplicates": {
      "enum": [
        "idempotency-key",
        "lookup",
        "external-reference",
        "none",
        "harmless",
        "unknown"
      ],
      "description": "How a destination handles a lead it may have seen (RFC-008 §4.3). unknown: not yet verified against the destination's sandbox; treated at runtime like external-reference or none (RFC-008 §4.3). Every kind is 'unknown' until there is evidence"
    }
  }
}
