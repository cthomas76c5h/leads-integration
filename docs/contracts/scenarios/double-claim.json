{
  "$schema": "../scenario.schema.json",
  "name": "double-claim",
  "story": "A worker claims a delivery and stalls just before its attempt starts. A second worker tries to claim it and gets nothing, because the first holds the lease. When the lease runs out, the delivery is recovered: no attempt had started, so nothing can have been sent, and it is simply claimed again and sent once. When the stalled worker wakes, its lease version is stale: it cannot start an attempt and sends nothing.",
  "slice": 3,
  "model": "lab",
  "proves": [
    "docs/rfc/008_delivery_guarantees_and_evidence.md#53-claims-and-revalidation (a lease, not a flag; only the holder records)",
    "docs/rfc/008_delivery_guarantees_and_evidence.md#42-an-unknown-outcome (an expired lease's attempt counts as unknown)"
  ],
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "hook",
        "firm": "firm-a",
        "kind": "webhook",
        "role": "usual",
        "duplicates": "idempotency-key"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "new-matter"
      }
    },
    {
      "at": "+0m",
      "fault": {
        "kind": "worker-stalls-before-send",
        "lead": "lead-1",
        "destination": "hook"
      }
    },
    {
      "at": "+10s",
      "fault": {
        "kind": "second-worker-claims",
        "lead": "lead-1",
        "destination": "hook"
      }
    },
    {
      "at": "+1m",
      "fault": {
        "kind": "lease-expires",
        "lead": "lead-1",
        "destination": "hook"
      }
    },
    {
      "at": "+2m",
      "fault": {
        "kind": "worker-continues",
        "lead": "lead-1",
        "destination": "hook"
      }
    }
  ],
  "then": [
    {
      "at": "+30s",
      "delivery": {
        "lead": "lead-1",
        "destination": "hook",
        "state": "sending",
        "attempts": 0,
        "count": 1
      }
    },
    {
      "at": "+5m",
      "delivery": {
        "lead": "lead-1",
        "destination": "hook",
        "state": "accepted",
        "attempts": 1,
        "outcomes": [
          "answered"
        ],
        "count": 1
      }
    },
    {
      "at": "+5m",
      "event": {
        "name": "LeaseRecovered",
        "lead": "lead-1",
        "destination": "hook",
        "count": 1
      }
    },
    {
      "at": "+5m",
      "event": {
        "name": "AttemptMade",
        "lead": "lead-1",
        "destination": "hook",
        "count": 1
      }
    },
    {
      "at": "+5m",
      "event": {
        "name": "DeliveryAccepted",
        "lead": "lead-1",
        "destination": "hook",
        "count": 1
      }
    },
    {
      "at": "+5m",
      "noEvent": {
        "name": "AttemptMade",
        "lead": "lead-1",
        "destination": "hook",
        "after": "+3m"
      }
    }
  ]
}
