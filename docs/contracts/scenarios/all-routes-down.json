{
  "$schema": "../scenario.schema.json",
  "name": "all-routes-down",
  "story": "A call about someone in custody (a 15-minute window) arrives while both the firm's email and its SMS fallback are down. Neither can deliver; at half the window the hand-off escalates to an operator who calls the firm, and when the window passes the lead expires, first in every view. Later, with the routes back, an emergency is accepted by email and then acknowledged by the firm through the link in it, so it is confirmed and never escalates.",
  "slice": 6,
  "model": "proposed",
  "proves": [
    "docs/rfc/008_delivery_guarantees_and_evidence.md#32-the-hand-off-revised (emergencies need acknowledgement; escalate at half the window)",
    "docs/rfc/008_delivery_guarantees_and_evidence.md#31-five-levels (accepted and acknowledged hand-offs are distinct)"
  ],
  "today": "The lab has no acknowledgement and no escalation: a hand-off is reached when a delivery is accepted. Expired leads are shown first in the Delivery Center (built). both-routes-down shows a similar outage for a new matter, without acknowledgement or escalation.",
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "email",
        "firm": "firm-a",
        "kind": "email",
        "role": "usual"
      },
      {
        "id": "sms",
        "firm": "firm-a",
        "kind": "sms",
        "role": "fallback"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "receiver": {
        "destination": "email",
        "answers": {
          "mode": "down"
        }
      }
    },
    {
      "at": "+0m",
      "receiver": {
        "destination": "sms",
        "answers": {
          "mode": "down"
        }
      }
    },
    {
      "at": "+1m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "jail-custody",
        "practiceArea": "criminal"
      }
    },
    {
      "at": "+40m",
      "receiver": {
        "destination": "email",
        "answers": {
          "mode": "ok"
        }
      }
    },
    {
      "at": "+40m",
      "receiver": {
        "destination": "sms",
        "answers": {
          "mode": "ok"
        }
      }
    },
    {
      "at": "+45m",
      "lead": {
        "id": "lead-2",
        "firm": "firm-a",
        "category": "emergency"
      }
    },
    {
      "at": "+47m",
      "action": {
        "by": "firm-contact",
        "do": "acknowledge",
        "lead": "lead-2",
        "via": "link"
      }
    }
  ],
  "then": [
    {
      "at": "+7m",
      "handOff": {
        "lead": "lead-1",
        "state": "pending",
        "evidence": "submitted"
      }
    },
    {
      "at": "+10m",
      "handOff": {
        "lead": "lead-1",
        "state": "pending",
        "evidence": "submitted",
        "escalated": true
      }
    },
    {
      "at": "+10m",
      "event": {
        "name": "HandOffEscalated",
        "lead": "lead-1",
        "count": 1
      }
    },
    {
      "at": "+17m",
      "handOff": {
        "lead": "lead-1",
        "state": "expired",
        "escalated": true
      }
    },
    {
      "at": "+17m",
      "outcome": {
        "lead": "lead-1",
        "is": "expired"
      }
    },
    {
      "at": "+17m",
      "event": {
        "name": "HandOffExpired",
        "lead": "lead-1",
        "count": 1
      }
    },
    {
      "at": "+46m",
      "handOff": {
        "lead": "lead-2",
        "state": "reached",
        "by": "email",
        "evidence": "accepted"
      }
    },
    {
      "at": "+48m",
      "handOff": {
        "lead": "lead-2",
        "state": "reached",
        "by": "email",
        "evidence": "acknowledged",
        "escalated": false
      }
    },
    {
      "at": "+48m",
      "event": {
        "name": "HandOffAcknowledged",
        "lead": "lead-2",
        "count": 1
      }
    },
    {
      "at": "+1h",
      "delivery": {
        "lead": "lead-1",
        "destination": "email",
        "state": "accepted",
        "late": true
      }
    },
    {
      "at": "+1h",
      "handOff": {
        "lead": "lead-1",
        "state": "expired"
      }
    },
    {
      "at": "+1h",
      "noEvent": {
        "name": "HandOffReached",
        "lead": "lead-1"
      }
    },
    {
      "at": "+1h",
      "noEvent": {
        "name": "HandOffEscalated",
        "lead": "lead-2"
      }
    },
    {
      "at": "+1h",
      "noEvent": {
        "name": "HandOffExpired",
        "lead": "lead-2"
      }
    }
  ]
}
