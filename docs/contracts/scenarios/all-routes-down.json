{
  "$schema": "../scenario.schema.json",
  "name": "all-routes-down",
  "story": "A call about someone in custody (a 24-hour window, a 15-minute fallback delay) arrives while both the firm's email and its SMS fallback are down, and stay down for over a day. Neither can deliver; after 15 minutes the hand-off escalates to an operator who calls the firm, and when the 24-hour window passes the lead expires, first in every view. Later, with the routes back, an emergency is accepted by email and then acknowledged by the firm through the link in it, so it is confirmed and never escalates.",
  "slice": 6,
  "model": "lab",
  "proves": [
    "docs/rfc/008_delivery_guarantees_and_evidence.md#32-the-hand-off-revised (emergencies need acknowledgement; escalate after the fallback delay)",
    "docs/rfc/008_delivery_guarantees_and_evidence.md#31-five-levels (accepted and acknowledged hand-offs are distinct)"
  ],
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "email",
        "firm": "firm-a",
        "kind": "email",
        "role": "usual"
      },
      {
        "id": "sms",
        "firm": "firm-a",
        "kind": "sms",
        "role": "fallback"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "receiver": {
        "destination": "email",
        "answers": {
          "mode": "down"
        }
      }
    },
    {
      "at": "+0m",
      "receiver": {
        "destination": "sms",
        "answers": {
          "mode": "down"
        }
      }
    },
    {
      "at": "+1m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "jail-custody",
        "practiceArea": "criminal"
      }
    },
    {
      "at": "+25h",
      "receiver": {
        "destination": "email",
        "answers": {
          "mode": "ok"
        }
      }
    },
    {
      "at": "+25h",
      "receiver": {
        "destination": "sms",
        "answers": {
          "mode": "ok"
        }
      }
    },
    {
      "at": "+25h05m",
      "lead": {
        "id": "lead-2",
        "firm": "firm-a",
        "category": "emergency"
      }
    },
    {
      "at": "+25h07m",
      "action": {
        "by": "firm-contact",
        "do": "acknowledge",
        "lead": "lead-2",
        "via": "link"
      }
    }
  ],
  "then": [
    {
      "at": "+10m",
      "handOff": {
        "lead": "lead-1",
        "state": "pending",
        "evidence": "submitted"
      }
    },
    {
      "at": "+17m",
      "handOff": {
        "lead": "lead-1",
        "state": "pending",
        "evidence": "submitted",
        "escalated": true
      }
    },
    {
      "at": "+17m",
      "event": {
        "name": "HandOffEscalated",
        "lead": "lead-1",
        "count": 1
      }
    },
    {
      "at": "+24h05m",
      "handOff": {
        "lead": "lead-1",
        "state": "expired",
        "escalated": true
      }
    },
    {
      "at": "+24h05m",
      "outcome": {
        "lead": "lead-1",
        "is": "expired"
      }
    },
    {
      "at": "+24h05m",
      "event": {
        "name": "HandOffExpired",
        "lead": "lead-1",
        "count": 1
      }
    },
    {
      "at": "+25h06m",
      "handOff": {
        "lead": "lead-2",
        "state": "reached",
        "by": "email",
        "evidence": "accepted"
      }
    },
    {
      "at": "+25h08m",
      "handOff": {
        "lead": "lead-2",
        "state": "reached",
        "by": "email",
        "evidence": "acknowledged",
        "escalated": false
      }
    },
    {
      "at": "+25h08m",
      "event": {
        "name": "HandOffAcknowledged",
        "lead": "lead-2",
        "count": 1
      }
    },
    {
      "at": "+46h",
      "delivery": {
        "lead": "lead-1",
        "destination": "email",
        "state": "accepted",
        "late": true
      }
    },
    {
      "at": "+46h",
      "handOff": {
        "lead": "lead-1",
        "state": "expired"
      }
    },
    {
      "at": "+46h",
      "noEvent": {
        "name": "HandOffReached",
        "lead": "lead-1"
      }
    },
    {
      "at": "+46h",
      "noEvent": {
        "name": "HandOffEscalated",
        "lead": "lead-2"
      }
    },
    {
      "at": "+46h",
      "noEvent": {
        "name": "HandOffExpired",
        "lead": "lead-2"
      }
    }
  ]
}
