{
  "$schema": "../scenario.schema.json",
  "name": "classification-corrected",
  "story": "Three calls are corrected. A general call corrected to a new matter while the cycle is open: both records kept, still billable, and the CRM it now matches is offered to an operator, not sent. After the cycle closes, a call billed as a new matter is corrected to a vendor solicitation: a credit next cycle. And a call left free as a vendor is corrected to a new matter: it stays free, because nothing is charged after a cycle closes.",
  "slice": 9,
  "model": "proposed",
  "proves": [
    "docs/rfc/008_delivery_guarantees_and_evidence.md#62-corrections (supersede; offer, never resend; credit, never a new charge after close)"
  ],
  "today": "The lab derives the category from the firm's label each time it reads a lead. There is no classification record, no review and no correction, and billing (Billing.conversations) is built from leads, so nothing is re-rated or credited.",
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "crm",
        "firm": "firm-a",
        "kind": "clio-grow",
        "role": "usual",
        "routing": {
          "categories": [
            "new-matter"
          ]
        }
      },
      {
        "id": "email",
        "firm": "firm-a",
        "kind": "email",
        "role": "usual"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "general"
      }
    },
    {
      "at": "+0m",
      "lead": {
        "id": "lead-2",
        "firm": "firm-a",
        "category": "new-matter"
      }
    },
    {
      "at": "+0m",
      "lead": {
        "id": "lead-3",
        "firm": "firm-a",
        "category": "vendor"
      }
    },
    {
      "at": "+10m",
      "action": {
        "by": "reviewer",
        "do": "correct-classification",
        "lead": "lead-1",
        "category": "new-matter"
      }
    },
    {
      "at": "+2h",
      "cycleCloses": {
        "firm": "firm-a"
      }
    },
    {
      "at": "+3h",
      "action": {
        "by": "firm-contact",
        "do": "correct-classification",
        "lead": "lead-2",
        "category": "vendor"
      }
    },
    {
      "at": "+3h",
      "action": {
        "by": "firm-contact",
        "do": "correct-classification",
        "lead": "lead-3",
        "category": "new-matter"
      }
    }
  ],
  "then": [
    {
      "at": "+20m",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "not-sent",
        "count": 1
      }
    },
    {
      "at": "+20m",
      "classification": {
        "lead": "lead-1",
        "category": "new-matter",
        "records": 2,
        "offered": [
          "crm"
        ]
      }
    },
    {
      "at": "+20m",
      "billing": {
        "lead": "lead-1",
        "is": "billable"
      }
    },
    {
      "at": "+1h",
      "billing": {
        "lead": "lead-2",
        "is": "billable"
      }
    },
    {
      "at": "+4h",
      "classification": {
        "lead": "lead-2",
        "category": "vendor",
        "records": 2
      }
    },
    {
      "at": "+4h",
      "billing": {
        "lead": "lead-2",
        "is": "credited-next-cycle"
      }
    },
    {
      "at": "+4h",
      "classification": {
        "lead": "lead-3",
        "category": "new-matter",
        "records": 2,
        "offered": [
          "crm"
        ]
      }
    },
    {
      "at": "+4h",
      "billing": {
        "lead": "lead-3",
        "is": "free"
      }
    },
    {
      "at": "+4h",
      "noDelivery": {
        "lead": "lead-3",
        "destination": "crm"
      }
    }
  ]
}
