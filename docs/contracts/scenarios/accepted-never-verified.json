{
  "$schema": "../scenario.schema.json",
  "name": "accepted-never-verified",
  "story": "The firm's CRM supports looking a record up by our lead reference. The first lead is accepted and then found: verified. Later the CRM starts accepting requests without the record ever appearing. The second lead stays accepted, never verified, and is flagged once the set time to verify has passed (assumed here to be two hours).",
  "slice": 3,
  "model": "lab",
  "proves": [
    "docs/rfc/008_delivery_guarantees_and_evidence.md#31-five-levels (accepted and verified are distinct levels)",
    "docs/rfc/008_delivery_guarantees_and_evidence.md#43-duplicate-handling-per-destination-kind (lookup gives verified)"
  ],
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "crm",
        "firm": "firm-a",
        "kind": "clio-grow",
        "role": "usual",
        "routing": {
          "categories": [
            "new-matter"
          ]
        },
        "duplicates": "lookup"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "new-matter"
      }
    },
    {
      "at": "+20m",
      "receiver": {
        "destination": "crm",
        "answers": {
          "mode": "lost-record"
        }
      }
    },
    {
      "at": "+25m",
      "lead": {
        "id": "lead-2",
        "firm": "firm-a",
        "category": "new-matter"
      }
    }
  ],
  "then": [
    {
      "at": "+10m",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "accepted",
        "evidence": "verified"
      }
    },
    {
      "at": "+10m",
      "event": {
        "name": "DeliveryVerified",
        "lead": "lead-1",
        "destination": "crm",
        "count": 1
      }
    },
    {
      "at": "+35m",
      "delivery": {
        "lead": "lead-2",
        "destination": "crm",
        "state": "accepted",
        "evidence": "accepted"
      }
    },
    {
      "at": "+3h",
      "delivery": {
        "lead": "lead-2",
        "destination": "crm",
        "state": "accepted",
        "evidence": "accepted",
        "verifyOverdue": true
      }
    },
    {
      "at": "+3h",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "accepted",
        "evidence": "verified"
      }
    },
    {
      "at": "+3h",
      "event": {
        "name": "VerificationOverdue",
        "lead": "lead-2",
        "destination": "crm",
        "count": 1
      }
    },
    {
      "at": "+3h",
      "noEvent": {
        "name": "DeliveryVerified",
        "lead": "lead-2",
        "destination": "crm"
      }
    },
    {
      "at": "+3h",
      "noEvent": {
        "name": "VerificationOverdue",
        "lead": "lead-1",
        "destination": "crm"
      }
    }
  ]
}
