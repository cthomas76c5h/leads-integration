{
  "$schema": "../scenario.schema.json",
  "name": "lead-problem",
  "story": "A caller hangs up before giving a name. MyCase requires one, so the lead is not sent there, as a lead problem: one lead's gap never counts against the firm's destination. The firm still has it by email.",
  "slice": 3,
  "model": "lab",
  "proves": [
    "docs/lead-delivery/README.md#3-a-leads-journey (planning step 4: a lead lacking a required field is not sent)",
    "docs/lead-delivery/README.md#switch-off (proposed: a lead problem never counts toward the streak)",
    "docs/lead-delivery/answers.md#speed-window-to-act-fallback-holding (hang-ups are not sent to CRMs)"
  ],
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "crm",
        "firm": "firm-a",
        "kind": "mycase",
        "role": "usual"
      },
      {
        "id": "email",
        "firm": "firm-a",
        "kind": "email",
        "role": "usual"
      }
    ]
  },
  "when": [
    {
      "at": "+5m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "new-matter",
        "hangUp": true
      }
    }
  ],
  "then": [
    {
      "at": "+10m",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "not-sent",
        "failureClass": "lead",
        "attempts": 0
      }
    },
    {
      "at": "+10m",
      "destination": {
        "id": "crm",
        "state": "live",
        "failureStreak": 0
      }
    },
    {
      "at": "+10m",
      "delivery": {
        "lead": "lead-1",
        "destination": "email",
        "state": "accepted"
      }
    }
  ]
}
