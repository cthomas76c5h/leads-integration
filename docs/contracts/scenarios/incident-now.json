{
  "$schema": "../scenario.schema.json",
  "name": "incident-now",
  "story": "PracticePanther answers 503 (Retry-After 60 s) for four hours. The firm has no fallback; its new matter keeps retrying and is accepted after PracticePanther recovers, well inside its 72-hour window: retries carry the lead through.",
  "slice": 6,
  "model": "lab",
  "proves": [
    "docs/lead-delivery/README.md#retry (transient failures retry, never sooner than Retry-After)",
    "docs/lead-delivery/README.md#window-to-act-and-fallback (72-hour window to act)"
  ],
  "given": {
    "clock": "2026-11-16T08:00:00-05:00",
    "firms": [
      {
        "id": "firm-a",
        "name": "Example Firm A"
      }
    ],
    "destinations": [
      {
        "id": "crm",
        "firm": "firm-a",
        "kind": "practicepanther",
        "role": "usual"
      }
    ]
  },
  "when": [
    {
      "at": "+0m",
      "receiver": {
        "destination": "crm",
        "answers": {
          "status": 503,
          "body": "unavailable",
          "retryAfter": "60"
        }
      }
    },
    {
      "at": "+0m",
      "lead": {
        "id": "lead-1",
        "firm": "firm-a",
        "category": "new-matter",
        "practiceArea": "criminal"
      }
    },
    {
      "at": "+4h",
      "receiver": {
        "destination": "crm",
        "answers": {
          "mode": "ok"
        }
      }
    }
  ],
  "then": [
    {
      "at": "+1h05m",
      "handOff": {
        "lead": "lead-1",
        "state": "pending"
      }
    },
    {
      "at": "+3h",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "retrying",
        "failureClass": "transient"
      }
    },
    {
      "at": "+11h",
      "delivery": {
        "lead": "lead-1",
        "destination": "crm",
        "state": "accepted"
      }
    },
    {
      "at": "+11h",
      "handOff": {
        "lead": "lead-1",
        "state": "reached"
      }
    },
    {
      "at": "+11h",
      "outcome": {
        "lead": "lead-1",
        "is": "accepted"
      }
    }
  ]
}
