{
  "$schema": "../receiver.schema.json",
  "kind": "answering-legal",
  "label": "Answering Legal web leads",
  "model": "lab",
  "request": {
    "method": "POST",
    "contentType": "application/json"
  },
  "requires": [
    {
      "field": "first_name",
      "from": "caller first name"
    },
    {
      "field": "last_name",
      "from": "caller last name"
    },
    {
      "field": "phone",
      "from": "caller phone"
    },
    {
      "field": "message",
      "from": "the message, without intake answers"
    }
  ],
  "optional": [
    {
      "field": "email",
      "from": "caller email"
    },
    {
      "field": "message_id",
      "from": "the lead id"
    },
    {
      "field": "custom",
      "from": "the intake answers, each as lookup_key, label and data"
    }
  ],
  "accepts": {
    "status": 201
  },
  "refusesMissing": {
    "status": 422,
    "body": "missing {field}"
  },
  "duplicates": "unknown",
  "afterUnknown": "operator",
  "evidence": {"strongest": "accepted", "how": "The platform's 2xx"},
  "handOff": "record",
  "remoteId": "unknown",
  "answers": "standard",
  "toConfirm": [
    "Duplicate handling: api-2 answers 208 Already Reported for an answer_id it already has (docs/lead-delivery/production-today.md), but this kind's body carries the lead id as message_id, not answer_id; confirm what the web-leads API keys on (RFC-008 §4.3)",
    "Whether its answer returns its own id for the record it made (remoteId)"
  ]
}
