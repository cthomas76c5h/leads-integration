{
  "$schema": "../receiver.schema.json",
  "kind": "answering-legal",
  "label": "Answering Legal web leads",
  "model": "lab",
  "request": {
    "method": "POST",
    "contentType": "application/json"
  },
  "requires": [
    {
      "field": "first_name",
      "from": "caller first name"
    },
    {
      "field": "last_name",
      "from": "caller last name"
    },
    {
      "field": "phone",
      "from": "caller phone"
    },
    {
      "field": "message",
      "from": "the message, without intake answers"
    }
  ],
  "optional": [
    {
      "field": "email",
      "from": "caller email"
    },
    {
      "field": "message_id",
      "from": "the lead id"
    },
    {
      "field": "custom",
      "from": "the intake answers, each as lookup_key, label and data"
    }
  ],
  "accepts": {
    "status": 201
  },
  "refusesMissing": {
    "status": 422,
    "body": "missing {field}"
  },
  "duplicates": "idempotency-key",
  "toConfirm": [
    "api-2 answers 208 Already Reported for an answer_id it already has (docs/lead-delivery/production-today.md); confirm the lab's message_id (the lead id) is what it keys on"
  ]
}
